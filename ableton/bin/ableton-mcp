#!/bin/sh
# Launches the AbletonMCP connector that connector/install.sh installs. Agent
# Plugins' mcp.json can't expand $HOME, so it points here instead. Clients may
# also start servers without HOME, so fall back to the user database.
if [ -z "${HOME:-}" ]; then
  HOME="$(eval printf '%s' "~$(id -un)")"
fi
exec "$HOME/.local/share/ableton-mcp/.venv/bin/ableton-mcp" "$@"
